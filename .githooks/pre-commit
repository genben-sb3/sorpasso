#!/bin/sh
# Baut mit Sanitizern und -Werror und führt alle Tests aus. Aktivieren: git config core.hooksPath .githooks
# Still bei Erfolg, volle Ausgabe nur bei einem Fehler.
log=$(mktemp) || exit 1
trap 'rm -f "$log"' EXIT
echo "pre-commit: Prüflauf läuft (cmake --workflow --preset pruefen)..." >&2
cmake --workflow --preset pruefen >"$log" 2>&1 || {
    rc=$?
    cat "$log" >&2
    echo "pre-commit: Prüflauf fehlgeschlagen (Exit-Code $rc)" >&2
    exit "$rc"
}
echo "pre-commit: Prüflauf grün" >&2
