#!/bin/sh
# Baut mit Sanitizern und -Werror und führt alle Tests aus. Aktivieren: git config core.hooksPath .githooks
# Still bei Erfolg, volle Ausgabe nur bei einem Fehler.
log=$(cmake --workflow --preset pruefen 2>&1) || {
    printf '%s\n' "$log"
    echo "pre-commit: Prüflauf (cmake --workflow --preset pruefen) fehlgeschlagen" >&2
    exit 1
}
echo "pre-commit: Prüflauf grün"
