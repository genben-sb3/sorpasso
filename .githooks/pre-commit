#!/bin/sh
# Check run of the physics package: unit/header check, then a build with sanitizers and -Werror and all tests.
# Only runs when the commit contains physics files (Source/UltraGravity/ or ultragravity/).
# Quiet on success, full output only on failure.
#
# Enable without cutting off the Git LFS hooks in .git/hooks (core.hooksPath stays unchanged;
# Git LFS does not use pre-commit):
#   ln -s ../../.githooks/pre-commit "$(git rev-parse --git-common-dir)/hooks/pre-commit"
root=$(git rev-parse --show-toplevel) || exit 1

if git diff --cached --quiet -- Source/UltraGravity ultragravity; then
    exit 0
fi

"$root/.githooks/check-units.sh" >&2 || {
    echo "pre-commit: unit/header check failed" >&2
    exit 1
}
log=$(mktemp) || exit 1
trap 'rm -f "$log"' EXIT
echo "pre-commit: check run in progress (cmake --workflow --preset check in ultragravity/)..." >&2
(cd "$root/ultragravity" && cmake --workflow --preset check) >"$log" 2>&1 || {
    rc=$?
    cat "$log" >&2
    echo "pre-commit: check run failed (exit code $rc)" >&2
    exit "$rc"
}
echo "pre-commit: check run green" >&2
