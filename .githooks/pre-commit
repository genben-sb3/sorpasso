#!/bin/sh
# Prüflauf des Physikpakets: Einheiten-/Header-Prüfung, dann Build mit Sanitizern und -Werror und alle Tests.
# Läuft nur, wenn der Commit Physik-Dateien enthält (Source/UltraGravity/ oder ultragravity/).
# Still bei Erfolg, volle Ausgabe nur bei einem Fehler.
#
# Aktivieren, ohne die Git-LFS-Hooks in .git/hooks abzuklemmen (core.hooksPath bleibt unverändert;
# Git LFS belegt pre-commit nicht):
#   ln -s ../../.githooks/pre-commit "$(git rev-parse --git-common-dir)/hooks/pre-commit"
root=$(git rev-parse --show-toplevel) || exit 1

if git diff --cached --quiet -- Source/UltraGravity ultragravity; then
    exit 0
fi

"$root/.githooks/check-einheiten.sh" >&2 || {
    echo "pre-commit: Einheiten-/Header-Prüfung fehlgeschlagen" >&2
    exit 1
}
log=$(mktemp) || exit 1
trap 'rm -f "$log"' EXIT
echo "pre-commit: Prüflauf läuft (cmake --workflow --preset pruefen in ultragravity/)..." >&2
(cd "$root/ultragravity" && cmake --workflow --preset pruefen) >"$log" 2>&1 || {
    rc=$?
    cat "$log" >&2
    echo "pre-commit: Prüflauf fehlgeschlagen (Exit-Code $rc)" >&2
    exit "$rc"
}
echo "pre-commit: Prüflauf grün" >&2
